# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
# Long random string. TradingView webhook URL: https://your-host/webhook?token=<WEBHOOK_SECRET>
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Alpaca API keys (paper keys from https://app.alpaca.markets)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# true = paper trading, false = LIVE money
ALPACA_PAPER=true
# true = log what would be sent, place no orders
DRY_RUN=false

# Sizing: alert (strategy position size) | fixed (FIXED_QTY) | notional (NOTIONAL_USD / price)
SIZING=alert
FIXED_QTY=1
NOTIONAL_USD=1000
# Safety caps, 0 = off
MAX_QTY=0
MAX_NOTIONAL_USD=5000

# Trading rules
ALLOW_SHORTS=true
# Fractional shares for long stock orders (shorts are always whole shares)
ALLOW_FRACTIONAL=false
# Comma-separated, empty = any symbol. Use Alpaca position symbols, e.g. AAPL,SPY,BTCUSD
ALLOWED_SYMBOLS=
# Skip stock signals while the market is closed (otherwise market orders queue for the open)
REJECT_WHEN_MARKET_CLOSED=true
# Ignore identical alerts received within this window
DEDUPE_WINDOW_MS=10000
# How long to wait for a close to fill before opening the reverse side
CLOSE_FILL_TIMEOUT_MS=15000

# Only accept requests from TradingView's webhook IPs (set TRUST_PROXY=true behind a proxy / PaaS)
TV_IP_ALLOWLIST=false
TRUST_PROXY=false

# ─── Self-running bot (npm run bot) ───────────────────────────────────────────
# Uses ALPACA_KEY_ID / ALPACA_SECRET_KEY / ALPACA_PAPER / DRY_RUN / ALLOW_SHORTS /
# MAX_QTY / MAX_NOTIONAL_USD from above.

# Symbols to trade (stocks, or crypto like BTCUSD)
SYMBOLS=SPY,QQQ
# Chart timeframe in minutes (1, 5, 15, 30, 60, 240) or D
TIMEFRAME=5
# Strategy inputs as JSON, same names as the Pine script inputs, e.g.
# {"preset":"Swing","exitAtMid":true,"riskPct":0.5,"flatAtClose":true}
STRATEGY_PARAMS={"preset":"Scalp"}
# iex (free) or sip (paid Alpaca data plan)
ALPACA_DATA_FEED=iex
# Stop opening new trades once the account is down this % since yesterday's close
MAX_DAILY_LOSS_PCT=3
# Bracket order time in force: gtc keeps stop/target alive overnight, day cancels them at the close
BRACKET_TIF=gtc
# How often to check for new bars, and how long after a bar closes to fetch it
POLL_SECONDS=10
BAR_DELAY_SECONDS=5
# With flatAtClose, positions are closed this many seconds before the market close
EOD_BUFFER_SECONDS=120
# Token for the bot's /status and /events endpoints (falls back to WEBHOOK_SECRET)
STATUS_TOKEN=
