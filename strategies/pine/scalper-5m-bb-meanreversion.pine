//@version=5
// Scalper — 5m Bollinger Band Mean-Reversion
// Fades band extremes on a volume spike + RSI extreme, targets the BB basis line.
// Built for 5m charts on liquid instruments (BTCUSD, QQQ, SPY).
strategy("Scalper - 5m Bollinger Mean-Reversion", shorttitle = "Scalp5m",
     overlay = true,
     default_qty_type = strategy.percent_of_equity, default_qty_value = 10,
     commission_type = strategy.commission.percent, commission_value = 0.05,
     slippage = 1, initial_capital = 10000, calc_on_every_tick = true)

// ---------------- Inputs ----------------
bbLen        = input.int(20, "BB Length")
bbMult       = input.float(2.0, "BB StdDev Mult", step = 0.1)
rsiLen       = input.int(14, "RSI Length")
rsiOS        = input.int(25, "RSI Oversold (extreme)")
rsiOB        = input.int(75, "RSI Overbought (extreme)")
volLen       = input.int(20, "Volume MA Length")
volMult      = input.float(1.3, "Min volume vs avg (x)", step = 0.1)
atrLen       = input.int(14, "ATR Length (hard stop backstop)")
atrMultSL    = input.float(1.5, "Hard stop = ATR x", step = 0.1)
use24h       = input.bool(false, "24h instrument (crypto) - disable session filter")
sessionStr   = input.session("0930-1600", "Trading session (equities only)")
maxTradesDay = input.int(6, "Max trades per day", minval = 1)

// ---------------- Series ----------------
[basis, upper, lower] = ta.bb(close, bbLen, bbMult)
rsi    = ta.rsi(close, rsiLen)
atr    = ta.atr(atrLen)
volAvg = ta.sma(volume, volLen)
volOk  = volume > volAvg * volMult

inSession = use24h or not na(time(timeframe.period, sessionStr))

var int tradesToday = 0
var int lastDayId   = 0
todayId = dayofmonth + month * 100 + year * 10000
if todayId != lastDayId
    tradesToday := 0
    lastDayId   := todayId

canTrade = inSession and tradesToday < maxTradesDay

longSignal  = canTrade and ta.crossunder(close, lower) and rsi < rsiOS and volOk
shortSignal = canTrade and ta.crossover(close, upper)  and rsi > rsiOB and volOk

// ---------------- Orders ----------------
if longSignal
    strategy.entry("Long", strategy.long)
    tradesToday += 1

if shortSignal
    strategy.entry("Short", strategy.short)
    tradesToday += 1

// Target = BB basis (recomputed each bar while pending); hard ATR stop as backstop.
if strategy.position_size > 0
    strategy.exit("XLong", "Long",
         stop  = strategy.position_avg_price - atr * atrMultSL,
         limit = basis)

if strategy.position_size < 0
    strategy.exit("XShort", "Short",
         stop  = strategy.position_avg_price + atr * atrMultSL,
         limit = basis)

// ---------------- Plots ----------------
plot(basis, "BB Basis", color = color.yellow)
plot(upper, "BB Upper", color = color.red)
plot(lower, "BB Lower", color = color.green)
